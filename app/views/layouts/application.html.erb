<!DOCTYPE html>
<html>
<head>
  <title>A Path | Assist</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=oncology,pets" />
  <%= javascript_importmap_tags %>
</head>

<body>
<nav class="navbar navbar-expand-lg navbar-light bg-light mb-3" id="navvy">
  <div class="container-fluid">
    <%= link_to "[ Antech Path Assist ]", root_path, class: "navbar-brand" %>
    &nbsp;
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Assists I requested", mine_consults_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Assists asked of me", assigned_consults_path, class: "nav-link" %>
          </li>
          <% if current_user&.can_accept_fbx_neo? %>
            <li class="nav-item">
              <%= link_to "New FBX NEO", new_fbx_neo_consult_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "FBX NEOs asked of me", mine_fbx_neo_consults_path, class: "nav-link" %>
            </li>
          <% end %>
        <% end %>
      </ul>
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <% if current_user&.admin? %>
            <li class="nav-item">
              <%= link_to "Edit Users", admin_users_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Dashboard", admin_dashboard_path, class: "nav-link" %>
            </li>
          <% end %>
          <li class="nav-item">
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "nav-link", form_class: "d-inline" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<%# Sidebar + main content wrapper %>
<div class="d-flex">

  <%# Specialty Sidebar — only show when logged in %>
  <% if user_signed_in? %>
    <div id="specialty-sidebar" class="border-end bg-light d-none d-lg-block" style="width: 210px; min-height: 100vh; flex-shrink: 0; overflow-y: auto;">
      <div class="px-2 pt-2 pb-3">

        <p class="fw-regular text-bold fs-5 text-decoration-underline mb-2 px-1;">Specialties

          <span class="material-symbols-outlined">oncology</span>

        </p>
        <br>
        <% {   
          "Bone" => ["Borst", "Cavender", "Fanzone", "Skirpstunas"],
          "Cardiovascular" => ["Aceino", "Ellis", "Fry"],
          "Dermatopathology" => ["Cavender", "Epperson", "Herd", "Locke", "Myers", "Piedra-Mora", "Sanchez", "Sweeney", "Tappe", "Turek", "Zoll"],
          "Equine" => ["Fisher", "Fry", "Krotec", "Myers", "Scanlon", "Schiller", "Skirpstunas", "Smith", "Sweeney", "Traslavina", "Watanabe", "Zoll"],
          "Fish" => ["Ford", "Imanse", "Rice", "Skirpstunas", "Traslavina"],
          "Gastrointestinal" => ["Bacmeister", "Franko", "Gerdin", "Locke", "Myers", "Schiller", "Vanderpool"],
          "Hepatobiliary" => ["Bera", "Fry", "Gerdin", "Popielarczyk", "Sokol (Ch)", "Traslavina", "Vanderpool"],
          "Immunohistochemistry" => ["Bacmeister", "Cavender", "Ehrensing", "Huang", "Labelle", "Oliveira"],
          "Infectious Diseases" => ["Borst", "Christensen", "Fisher", "Fry", "Hauck", "Imanse", "McDermott", "Rice", "Traslavina", "Watanabe", "Yau"],
          "Farm / Large Animal" => ["Aceino", "Fisher", "Ford", "Fry", "Hauck", "Imanse", "McDermott", "Myers", "Popielarczyk", "Roady", "Skirpstunas", "Smith", "Sweeney", "Traslavina", "Watanabe"],
          "Neuropathology" => ["Bacmeister", "Oliveira", "Popielarczyk", "Sanchez", "Traslavina"],
          "Ocular" => ["Ellis (Ch)", "Fisher", "Krotec", "Labelle", "Lund", "Ranck", "Roady", "Scanlon"],
          "Oncologic" => ["Aceino (PCT)", "Bacmeister (PCT)", "Bera", "Boker", "Ehrensing (PCT)", "Epperson", "Franko", "Fry", "Gerdin", "Iverson", "Krotec", "Labelle (PCT)", "Lin", "Locke", "Myers", "Oliveira (PCT Ch)", "Ranck (PCT)", "Scanlon (PCT)", "Schiller", "Skirpstunas", "Smith (PCT)", "Tappe", "Vanderpool", "Zoll"],
          "Oral" => ["Fry", "Harvey (OT)", "Huang (OT)", "Imanse (OT)", "Lund (OT)", "Sanchez (OT Ch)"],
          "Renal / Urinary" => ["Gerdin"],
          "Reproductive" => ["Hauck", "Herd", "Lin", "Lund", "Ranck", "Skirpstunas"],
          "Respiratory" => ["Bera", "Ford", "Gerdin"],
          "Zoo / PocketPets / Exotics" => ["Bacmeister", "Ellis", "Fisher", "Ford", "Hauck", "Imanse (Ch)", "McDermott", "Rice", "Schiller", "Skirpstunas", "Sokol", "Traslavina", "Yau"]
        }.each_with_index do |(specialty, doctors), index| %>
          <% slug = specialty.downcase.gsub(/[^a-z0-9]/, "-").gsub(/-+/, "-") %>
          <div class="mb-1">
            <button class="btn btn-sm btn-light w-100 text-start d-flex justify-content-between align-items-center py-1"
                    data-bs-toggle="collapse"
                    data-bs-target="#spec-<%= slug %>"
                    style="font-size: 1.1em;">
              <span><%= specialty %></span> <span class="text-muted"></span>
            </button>
            <div class="collapse" id="spec-<%= slug %>">
              <ul class="ps-3 mb-0">
                <% doctors.each do |doc| %>
                <li class="text-muted py-0"><%= doc %></li>
                <% end %>
             </ul>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  <% end %>

  <%# Main content %>
  <div class="flex-grow-1" style="min-width: 0;">
    <div class="floater">
      <% if user_signed_in? %>
        <h6><u><%= current_user&.name %></u></h6>
      <% end %>
    </div>

    <div class="container">
      <% if notice %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <div class="text-center mb-4">
        <%= image_tag "hero.jpg", style: "width: 220px; height: auto;" %>
      </div>

      <%= yield %>
    </div>
  </div>

</div>
</body>
</html>