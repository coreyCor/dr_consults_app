<!DOCTYPE html>
<html>
<head>
  <title>A Path | Assist</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=oncology,pets" />
  <%= javascript_importmap_tags %>
</head>

<body>

<%# top navbar %>  
<nav class="navbar navbar-expand-lg navbar-light border-bottom shadow-sm" id="navvy">
  <div class="container-fluid">
    <%= link_to "[ Antech Path Assist ]", root_path, class: "navbar-brand" %>
    &nbsp;
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Assists I requested", mine_consults_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Assists asked of me", assigned_consults_path, class: "nav-link" %>
          </li>
          <% if current_user&.can_accept_fbx_neo? %>
            <li class="nav-item">
              <%= link_to "New FBX NEO", new_fbx_neo_consult_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "FBX NEOs asked of me", mine_fbx_neo_consults_path, class: "nav-link" %>
            </li>
          <% end %>
        <% end %>
      </ul>
      <ul class="navbar-nav ms-auto">
        <% if user_signed_in? %>
          <% if current_user&.admin? %>
            <li class="nav-item">
              <%= link_to "Edit Users", admin_users_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Dashboard", admin_dashboard_path, class: "nav-link" %>
            </li>
          <% end %>
          <li class="nav-item">
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "nav-link", form_class: "d-inline" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<%# Sidebar + main content wrapper %>
<div class="d-flex">

  <%# Specialty Sidebar — only show when logged in %>
  <% if user_signed_in? %>

    <div id="specialty-sidebar" class="border-end bg-light d-none d-lg-block" 
     style="width: 210px; height: calc(100vh - 56px); flex-shrink: 0; overflow-y: auto; position: sticky; top: 56px; align-self: flex-start;">
      <div class="px-2 pt-2 pb-3">
        
        <br>
        <p class="fw-regular fs-5 text-decoration-none mb-2 px-1;">Specialties Reference
          
          <span class="material-symbols-outlined">oncology</span>

        </p>
        <br>
        <% {   
          "Bone" => ["Borst", "Cavender", "Fanzone", "Skirpstunas"],
          "Cardiovascular" => ["Aceino", "Ellis", "Fry"],
          "Dermatopathology" => ["Cavender", "Epperson", "Herd", "Locke", "Myers", "Piedra-Mora", "Sanchez", "Sweeney", "Tappe", "Turek", "Zoll"],
          "Equine" => ["Fisher", "Fry", "Krotec", "Myers", "Scanlon", "Schiller", "Skirpstunas", "Smith", "Sweeney", "Traslavina", "Watanabe", "Zoll"],
          "Fish" => ["Ford", "Imanse", "Rice", "Skirpstunas", "Traslavina"],
          "Gastrointestinal" => ["Bacmeister", "Franko", "Gerdin", "Locke", "Myers", "Schiller", "Vanderpool"],
          "Hepatobiliary" => ["Bera", "Fry", "Gerdin", "Popielarczyk", "Sokol (Ch)", "Traslavina", "Vanderpool"],
          "Immunohistochemistry" => ["Bacmeister", "Cavender", "Ehrensing", "Huang", "Labelle", "Oliveira"],
          "Infectious Diseases" => ["Borst", "Christensen", "Fisher", "Fry", "Hauck", "Imanse", "McDermott", "Rice", "Traslavina", "Watanabe", "Yau"],
          "Farm / Large Animal" => ["Aceino", "Fisher", "Ford", "Fry", "Hauck", "Imanse", "McDermott", "Myers", "Popielarczyk", "Roady", "Skirpstunas", "Smith", "Sweeney", "Traslavina", "Watanabe"],
          "Neuropathology" => ["Bacmeister", "Oliveira", "Popielarczyk", "Sanchez", "Traslavina"],
          "Ocular" => ["Ellis (Ch)", "Fisher", "Krotec", "Labelle", "Lund", "Ranck", "Roady", "Scanlon"],
          "Oncologic" => ["Aceino (PCT)", "Bacmeister (PCT)", "Bera", "Boker", "Ehrensing (PCT)", "Epperson", "Franko", "Fry", "Gerdin", "Iverson", "Krotec", "Labelle (PCT)", "Lin", "Locke", "Myers", "Oliveira (PCT Ch)", "Ranck (PCT)", "Scanlon (PCT)", "Schiller", "Skirpstunas", "Smith (PCT)", "Tappe", "Vanderpool", "Zoll"],
          "Oral" => ["Fry", "Harvey (OT)", "Huang (OT)", "Imanse (OT)", "Lund (OT)", "Sanchez (OT Ch)"],
          "Renal / Urinary" => ["Gerdin"],
          "Reproductive" => ["Hauck", "Herd", "Lin", "Lund", "Ranck", "Skirpstunas"],
          "Respiratory" => ["Bera", "Ford", "Gerdin"],
          "Zoo/ PocketPets/ Exotics" => ["Bacmeister - (Sm Mammal)", "Ellis - (Sm Mammal)", "Fisher - (Sm Mammal)", "Ford", "Hauck", "Imanse (Ch)", "McDermott", "Rice", "Schiller", "Skirpstunas", "Sokol", "Traslavina", "Yau"]
        }.each_with_index do |(specialty, doctors), index| %>
          <% slug = specialty.downcase.gsub(/[^a-z0-9]/, "-").gsub(/-+/, "-") %>
          <div class="mb-1">
            <button class="btn btn-sm btn-light w-100 text-start d-flex justify-content-between align-items-center py-1"
                    data-bs-toggle="collapse"
                    data-bs-target="#spec-<%= slug %>"
                    style="font-size: 1.1em;">
              <span><%= specialty %></span> <span class="text-muted"></span>
              <i class="bi bi-chevron-down"></i>
            </button>
            <div class="collapse" id="spec-<%= slug %>">
              <ul class="ps-3 mb-0">
                <% doctors.each do |doc| %>
                <li class="text-muted py-0"><%= doc %></li>
                <% end %>
             </ul>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  <% end %>

  <%# Main content %>
  <div class="flex-grow-1" style="min-width: 0;">
    <div class="floater">
      <% if user_signed_in? %>
        <h6><p class ="name_on_page">Hi, <%= current_user&.name %></p></h6>
      <% end %>
    </div>

    <div class="container">
      <% if notice %>
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <div class="text-start mb-2">
        <%= image_tag "hero.jpg", class: "ms-0", style: "width: 175px; height: auto;" %>
      </div>

      <%= yield %>
    </div>
  </div>

</div>
<%# this is the floating button%>

<%# Floating schedule button — only show when logged in %>
<% if user_signed_in? %>

  <%# Floating button %>
  <button type="button"
          class="btn btn-purple rounded-circle shadow"
          data-bs-toggle="modal"
          data-bs-target="#scheduleModal"
          style="position: fixed; bottom: 30px; right: 30px; width: 56px; height: 56px; font-size: 1.4rem; z-index: 1050;">
          <i class="bi bi-calendar-date-fill"></i>
  </button>

  <%# Modal %>
  <div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="scheduleModalLabel">Schedule</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-0">
          <iframe src="/schedule.pdf" width="100%" height="600px" style="border: none;"></iframe>
        </div>
      </div>
    </div>
  </div>

<% end %>


<nav class="navbar sticky-bottom bg-body-tertiary border-top">
  <div class="container-fluid">
    <h6> Path-assist beta </h6>
  </div>
</nav>

 </body>
</html>