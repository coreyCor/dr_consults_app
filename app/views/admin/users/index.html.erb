<h2 class="pageheader"><i>All users</i></h2>
<br>

<% if current_user.admin? %>
  <%= link_to "Create New User +", new_admin_user_path, class: "btn btn-purple" %>
<% end %>

<br><br>

<%= link_to "📅 7 Day Path Schedule", weekly_schedule_admin_users_path, class: "btn btn-outline-primary mb-3" %>

<br><br>

<div class="row row-cols-1 row-cols-md-2 g-4">
  <% @users.order(:name).each do |user| %>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong><%= user.name %></strong>
          <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-sm btn-purple" %>
        </div>
        <div class="card-body">
          <p class="mb-1"><small class="text-muted">Email:</small> <%= user.email %></p>
          <p class="mb-1"><small class="text-muted">Role:</small> <%= user.user_role.capitalize %></p>
          <p class="mb-1"><small class="text-muted">Daily Limit:</small> <%= user.daily_consult_limit || "N/A" %></p>
          <p class="mb-1"><small class="text-muted">Cooldown:</small> <%= user.cooldown_minutes ? "#{user.cooldown_minutes} min" : "N/A" %></p>
          

          <% if user.availabilities.any? %>
            <hr>
            <p class="mb-1 fw-semibold small">Weekly Schedule</p>
            <table class="table table-sm table-borderless mb-0">
              <thead class="table-light">
                <tr>
                  <th class="small">Day</th>
                  <th class="small">Start</th>
                  <th class="small">End</th>
                  <th class="small">Off</th>
                </tr>
              </thead>
              <tbody>
                <% user.availabilities.order(:day_of_week).each do |a| %>
                  <tr>
                    <td class="small"><%= Date::DAYNAMES[a.day_of_week] %></td>
                    <td class="small"><%= a.start_time&.strftime("%I:%M %p") || "–" %></td>
                    <td class="small"><%= a.end_time&.strftime("%I:%M %p") || "–" %></td>
                    <td class="small"><%= a.off? ? "Off" : "" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>

        </div>
      </div>
    </div>
  <% end %>
</div>

<br>
<div>
  <%= link_to "← Back", :back, class: "btn btn-purple" %>
</div>
<br>
<% if current_user.admin? %>
  <%= link_to "Create New User", new_admin_user_path, class: "btn btn-purple" %>
<% end %>
<br><br>