<h2 class="pageheader">Admin Dashboard</h2>
<br>
<hr>
<br>

<%# Stat cards %>
<div class="row mb-4">
  <div class="col-md-6">
    <div class="card text-center shadow-sm">
      <div class="card-body">
        <h3><%= @total_today %></h3>
        <p class="text-muted mb-0">Assists Today</p>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card text-center shadow-sm">
      <div class="card-body">
        <h3><%= @fbx_neos_today %></h3>
        <p class="text-muted mb-0">FBX NEOs Today</p>
      </div>
    </div>
  </div>
</div>

<br>
<p class="text-muted small">Showing the last 30 days</p>
<br>

<%# Consults grouped by date %>
<% if @consults_by_date.empty? %>
  <p class="text-muted">No assists yet.</p>
<% else %>
  <div class="accordion shadow-sm" id="consultsAccordion">
    <% @consults_by_date.each_with_index do |(date, consults), index| %>
      <% slug = date.strftime("%Y-%m-%d") %>
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-<%= slug %>">
          <button class="accordion-button <%= "collapsed" unless index.zero? %>"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#collapse-<%= slug %>"
                  aria-expanded="<%= index.zero? %>"
                  aria-controls="collapse-<%= slug %>">
            <span class="fw-semibold"><%= date.strftime("%B %-d, %Y") %></span> &nbsp;
            <span>Total : <%= consults.size %></span>
          </button>
        </h2>
        <div id="collapse-<%= slug %>"
             class="accordion-collapse collapse <%= "show" if index.zero? %>"
             aria-labelledby="heading-<%= slug %>">
          <div class="accordion-body p-0">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Accession</th>
                  <th>Type</th>
                  <th class="sortable-col" data-col="2" style="cursor: pointer;">
                    Requested By <i class="bi bi-chevron-expand ms-1"></i>
                  </th>
                  <th class="sortable-col" data-col="3" style="cursor: pointer;">
                    Assigned To <i class="bi bi-chevron-expand ms-1"></i>
                  </th>
                  <th>Sent</th>
                </tr>
              </thead>
              <tbody>
                <% consults.each do |consult| %>
                  <tr>
                    <td>
                      <%= link_to consult.title,
                          consult.fbx_neo? ? fbx_neo_consult_path(consult) : consult_path(consult) %>
                    </td>
                    <td>
                      <% if consult.fbx_neo? %>
                        <span class="badge bg-danger">FBX NEO</span>
                      <% else %>
                        <span class="badge bg-secondary">Standard</span>
                      <% end %>
                    </td>
                    <td data-sort="<%= consult.asked_by&.last_name&.downcase %>">
                      <%= consult.asked_by&.name %>
                    </td>
                    <td data-sort="<%= consult.fbx_neo? ? "" : consult.assigned_to&.last_name&.downcase %>">
                      <% if consult.fbx_neo? %>
                        Team (<%= consult.consult_assignments.size %>)
                      <% else %>
                        <%= consult.assigned_to&.name || "Unassigned" %>
                      <% end %>
                    </td>
                    <td><%= consult.created_at.in_time_zone.strftime("%I:%M %p") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<br>
<%= link_to "← Back", root_path, class: "btn btn-primary" %>

<script>
  document.querySelectorAll('.sortable-col').forEach(function(header) {
    header.addEventListener('click', function() {
      const table = this.closest('table');
      const tbody = table.querySelector('tbody');
      const colIndex = parseInt(this.dataset.col, 10);
      const dir = this.dataset.dir === 'asc' ? 'desc' : 'asc';

      // reset headers in this table only
      table.querySelectorAll('.sortable-col').forEach(function(h) {
        h.dataset.dir = '';
        h.querySelector('i').className = 'bi bi-chevron-expand ms-1';
      });

      this.dataset.dir = dir;
      this.querySelector('i').className = dir === 'asc'
        ? 'bi bi-chevron-up ms-1'
        : 'bi bi-chevron-down ms-1';

      const rows = Array.from(tbody.querySelectorAll('tr'));

      rows.sort(function(a, b) {
        const cellA = a.children[colIndex];
        const cellB = b.children[colIndex];
        const valA = (cellA.dataset.sort || cellA.textContent).trim().toLowerCase();
        const valB = (cellB.dataset.sort || cellB.textContent).trim().toLowerCase();
        return dir === 'asc'
          ? valA.localeCompare(valB)
          : valB.localeCompare(valA);
      });

      rows.forEach(function(r) { tbody.appendChild(r); });
    });
  });
</script>