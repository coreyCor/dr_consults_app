<turbo-frame id="row_frame_<%= user.id %>">
  <div class="table-row">
    <div>
      <% available = user.can_receive_consults? &&
                     user.available_now? &&
                     user.eligible_by_limits_and_cooldown? %>

      <% if available %>
        <%= link_to user.name,
              new_consult_path(assigned_to_id: user.id),
              data: { turbo_frame: "_top" },
              class: "fw-semibold" %>
      <% else %>
        <span class="text-muted"><%= user.name %></span>
        <span class="material-symbols-outlined">pets</span>
      <% end %>
    </div>

    <div>
      <%= user.local_time.strftime("%I:%M %p") %>
      <%= user.time_zone %>
    </div>

    <div>
  <% case user.badge_status %>
  <% when :available %>
    <span class="badge rounded-pill bg-success border border-success text-light">Available</span>
  <% when :done %>
    <span class="badge rounded-pill bg-transparent border border-secondary text-dark">Finished </span>
  <% else %>
    <span class="badge rounded-pill bg-transparent border border-secondary text-dark">Paused  ! </span>
  <% end %>
  </div>



    <div>
      <%= user.works_tomorrow? ? "Y" : "N" %>
    </div>
  </div>
</turbo-frame>
<p>&nbsp</p>