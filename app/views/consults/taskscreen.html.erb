<div class="text-end">
<% if user_signed_in? %>
  <%= turbo_stream_from "daily_counter_#{current_user.id}" %>
  <%= render partial: "consults/daily_counter", locals: { user: current_user } %>
<% end %>
</div>
<h3 class = "pageheader">Request an assist</h3>


<div class = "text-start">
   <small class="text-muted">↕ Scroll inside table to see all pathologists</small>

</div>
<br>
<div class="availability-wrapper">
  <div class="availability-table" >

  <div class="table-header">
    <div>Pathologist</div>
    <div>Current Local Time</div>
    <div>Available for Assist </div>
    <div>Works Tomorrow?</div>
  </div>

  <% @eligible_users.each do |user| %>
    <%= turbo_frame_tag "row_frame_#{user.id}",
          src: availability_row_user_path(user),
          data: {
            controller: "availability-refresh",
            availability_refresh_interval_value: 30000
          } %>
  <% end %>


</div>

</div>
